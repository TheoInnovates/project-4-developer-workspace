# Enabled service profiles
# Remove a profile to disable that group of services, then redeploy.
#
#   dev        - gitlab, gitlab-runner, nexus, registry
#   monitoring - prometheus, grafana, loki, promtail
#   storage    - minio
#   security   - vault
#   infra      - portainer
#   qwen38     - vllm-qwen38   (Qwen3.8-27B-FP8, GPU)
#   nemotron   - vllm-nemotron (Nemotron 3 Super 120B NVFP4, GPU) — retired,
#                kept as the rollback for qwen38; both bind :8001, so enable
#                one or the other, never both
#   coder      - vllm-coder    (Qwen3-Coder-Next-FP8, GPU)
#   webui      - openwebui     (chat frontend, talks to vllm endpoints)
#   search     - searxng       (private metasearch, feeds OpenWebUI RAG)
#   ide        - code-server   (VS Code in the browser)
#   status     - uptime-kuma   (status / uptime monitor)
#
# Always on (no profile): caddy, homepage, watchtower
#
# Dependencies (must be enabled/disabled together):
#   - dev: gitlab-runner depends on gitlab (all-or-nothing for those two)
#   - monitoring: promtail -> loki -> grafana (all four are a unit)
#   - storage, security, infra, qwen38, coder, webui, search, ide, status: fully independent
#
# Per-host topology:
#   - Spark 1 (spark-d5dd): qwen38   (the dev/monitoring/storage/security/infra/
#     webui/search/ide/status groups moved to the devhub VM on pve1)
#   - Spark 2 (spark-06ad): coder
#   - devhub VM on pve1 (no GPU): everything except qwen38/coder
#
# scripts/deploy.sh injects the right COMPOSE_PROFILES per target,
# so this value is just the local default.

COMPOSE_PROFILES=dev,monitoring,storage,security,infra,qwen38,webui,search,ide,status

# TLS profile: local (mkcert), cloud (self-signed), aws (ACM certs + real domain)
TLS_PROFILE=local
