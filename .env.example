# =============================================================================
# Developer Workspace Environment Configuration
# =============================================================================
# Copy this file to .env and update the passwords below.
# Hostnames default to *.local for local development.

# Bind-mount base for stateful volumes (gitlab/nexus/etc.)
# Windows example: E:/devstack/volumes
# Linux example:   /home/tforrester/devstack/volumes
VOLUMES_BASE=E:/devstack/volumes

# Domain suffix for local services
DOMAIN_SUFFIX=local

# Hostnames
HOMEPAGE_HOST=home.local
GITLAB_HOST=gitlab.local
NEXUS_HOST=nexus.local
PROMETHEUS_HOST=prometheus.local
GRAFANA_HOST=grafana.local
PORTAINER_HOST=portainer.local
REGISTRY_HOST=registry.local
MINIO_HOST=minio.local
MINIO_API_HOST=s3.local
VAULT_HOST=vault.local
OPENWEBUI_HOST=chat.local
SEARXNG_HOST=search.local
CODESERVER_HOST=ide.local
UPTIME_HOST=status.local

# GitLab
GITLAB_SSH_PORT=2222
GITLAB_ROOT_PASSWORD=CHANGE_ME_GITLAB_PASSWORD

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# MinIO
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD

# Nexus (default admin password is generated on first run, check volumes/nexus-data/admin.password)

# Vault (initialized on first run via `vault operator init`)

# OpenWebUI — chat frontend (profile: webui)
WEBUI_NAME=Devstack
# Semicolon-separated lists matching positionally:
OPENWEBUI_API_BASE_URLS=http://host.docker.internal:8001/v1;http://spark-06ad:8001/v1
OPENWEBUI_API_KEYS=local-vllm-key;local-vllm-key
ENABLE_RAG_WEB_SEARCH=true
RAG_WEB_SEARCH_ENGINE=searxng

# SearXNG — search backend (profile: search)
# Generate with: openssl rand -hex 32
SEARXNG_SECRET=CHANGE_ME_SEARXNG_SECRET

# code-server — web IDE (profile: ide)
CODESERVER_PASSWORD=CHANGE_ME_CODESERVER_PASSWORD
CODESERVER_SUDO_PASSWORD=
CODESERVER_WORKSPACE=/home/tforrester/projects
PUID=1000
PGID=1000
TZ=America/Chicago

# TLS Certificate paths (mounted into the caddy service at /certs)
TLS_CERT_FILE=/certs/cert.pem
TLS_KEY_FILE=/certs/key.pem
