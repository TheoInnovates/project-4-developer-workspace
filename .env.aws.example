# =============================================================================
# AWS Domain Environment Configuration
# =============================================================================
# Copy this to .env.aws and update the domain and passwords.
# Import ACM certs: powershell -File scripts/import-acm-certs.ps1 -CertFile cert.pem -KeyFile key.enc.pem -ChainFile chain.pem -Passphrase "your-passphrase"

# Domain suffix for AWS-domain services
DOMAIN_SUFFIX=example.com

# Hostnames
HOMEPAGE_HOST=home.example.com
GITLAB_HOST=gitlab.example.com
NEXUS_HOST=nexus.example.com
PROMETHEUS_HOST=prometheus.example.com
GRAFANA_HOST=grafana.example.com
TRAEFIK_HOST=traefik.example.com
PORTAINER_HOST=portainer.example.com
REGISTRY_HOST=registry.example.com
MINIO_HOST=minio.example.com
MINIO_API_HOST=s3.example.com
VAULT_HOST=vault.example.com

# GitLab
GITLAB_SSH_PORT=2222
GITLAB_ROOT_PASSWORD=CHANGE_ME_GITLAB_PASSWORD

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# MinIO
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD

# TLS Certificate paths (imported via import-acm-certs script)
TLS_CERT_FILE=/etc/traefik/certs/cert.pem
TLS_KEY_FILE=/etc/traefik/certs/key.pem
