# Base Caddyfile merged with the per-service config that caddy-docker-proxy
# generates from `caddy.*` Docker labels. Holds global options and the shared
# (tls_certs) snippet that every site imports.
{
	# caddy-docker-proxy forces the admin API onto localhost:2019 (it needs
	# exclusive control of it), so `admin :2019` here would be ignored. The
	# global metrics option enables collection; the :2020 site below exposes
	# them to Prometheus over the devstack network.
	metrics
}

# Prometheus scrape endpoint: http://caddy:2020/metrics
:2020 {
	metrics
}

# Serve the pre-provisioned certificate (mkcert / self-signed / exported ACM,
# standardized as cert.pem + key.pem). Supplying explicit certs disables ACME
# for these sites, so no public reachability is required.
(tls_certs) {
	tls /certs/cert.pem /certs/key.pem
}
