# =============================================================================
# Spark 1 (spark-d5dd) - dev stack + Nemotron co-tenant
# =============================================================================
# Copy this to .env.spark-d5dd and update passwords / model id as needed.

# Bind-mount base for stateful volumes (gitlab/nexus/etc.)
VOLUMES_BASE=/home/tforrester/devstack/volumes

# Domain suffix for service hostnames
DOMAIN_SUFFIX=spark-d5dd

# Hostnames (resolve via Tailscale MagicDNS or /etc/hosts)
HOMEPAGE_HOST=home.spark-d5dd
GITLAB_HOST=gitlab.spark-d5dd
NEXUS_HOST=nexus.spark-d5dd
PROMETHEUS_HOST=prometheus.spark-d5dd
GRAFANA_HOST=grafana.spark-d5dd
TRAEFIK_HOST=traefik.spark-d5dd
PORTAINER_HOST=portainer.spark-d5dd
REGISTRY_HOST=registry.spark-d5dd
MINIO_HOST=minio.spark-d5dd
MINIO_API_HOST=s3.spark-d5dd
VAULT_HOST=vault.spark-d5dd

# GitLab
GITLAB_SSH_PORT=2222
GITLAB_ROOT_PASSWORD=CHANGE_ME_GITLAB_PASSWORD

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# MinIO
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD

# TLS Certificate paths
TLS_CERT_FILE=/etc/traefik/certs/cert.pem
TLS_KEY_FILE=/etc/traefik/certs/key.pem

# vLLM - Nemotron Super 49B FP8 (local on this host)
VLLM_API_KEY=local-vllm-key
VLLM_NEMOTRON_MODEL=nvidia/Llama-3_3-Nemotron-Super-49B-v1_5-FP8
VLLM_NEMOTRON_PORT=8001
VLLM_NEMOTRON_HREF_HOST=spark-d5dd
HF_CACHE_DIR=/home/tforrester/.cache/huggingface

# Unused on this host (Coder runs on spark-06ad) — declared empty so compose
# doesn't warn when parsing the vllm-coder service's labels.
VLLM_CODER_MODEL=
VLLM_CODER_PORT=
VLLM_CODER_HREF_HOST=
