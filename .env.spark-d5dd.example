# =============================================================================
# Spark 1 (spark-d5dd) - dev stack + Nemotron co-tenant
# =============================================================================
# Copy this to .env.spark-d5dd and update passwords / model id as needed.

# Bind-mount base for stateful volumes (gitlab/nexus/etc.)
VOLUMES_BASE=/home/tforrester/devstack/volumes

# Domain suffix for service hostnames
DOMAIN_SUFFIX=devhub.ninja

# This host's Tailscale IPv4 — Caddy binds 80/443 here so tailnet peers reach
# the services. Create a Route53 record *.devhub.ninja -> this IP.
# Find it with: tailscale ip -4
TAILSCALE_IP=100.64.0.1

# Hostnames (resolve via Route53 *.devhub.ninja -> this host's Tailscale IP)
HOMEPAGE_HOST=home.devhub.ninja
GITLAB_HOST=gitlab.devhub.ninja
NEXUS_HOST=nexus.devhub.ninja
PROMETHEUS_HOST=prometheus.devhub.ninja
ALERTMANAGER_HOST=alertmanager.devhub.ninja
GRAFANA_HOST=grafana.devhub.ninja
PORTAINER_HOST=portainer.devhub.ninja
REGISTRY_HOST=registry.devhub.ninja
MINIO_HOST=minio.devhub.ninja
MINIO_API_HOST=s3.devhub.ninja
VAULT_HOST=vault.devhub.ninja
OPENWEBUI_HOST=chat.devhub.ninja
SEARXNG_HOST=search.devhub.ninja
CODESERVER_HOST=ide.devhub.ninja
UPTIME_HOST=status.devhub.ninja

# GitLab
GITLAB_SSH_PORT=2222
GITLAB_ROOT_PASSWORD=CHANGE_ME_GITLAB_PASSWORD

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# MinIO
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD


# vLLM - Nemotron Super 49B FP8 (local on this host)
VLLM_API_KEY=local-vllm-key
VLLM_NEMOTRON_MODEL=nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-NVFP4
VLLM_NEMOTRON_PORT=8001
VLLM_NEMOTRON_HREF_HOST=spark-d5dd
HF_CACHE_DIR=/home/tforrester/.cache/huggingface

# Unused on this host (Coder runs on spark-06ad) — declared empty so compose
# doesn't warn when parsing the vllm-coder service's labels.
VLLM_CODER_MODEL=
VLLM_CODER_PORT=
VLLM_CODER_HREF_HOST=

# OpenWebUI (profile: webui)
WEBUI_NAME=Devstack
# Both vLLM endpoints — Nemotron via host gateway, Coder via spark-06ad MagicDNS/LAN
OPENWEBUI_API_BASE_URLS=http://host.docker.internal:8001/v1;http://spark-06ad:8001/v1
OPENWEBUI_API_KEYS=local-vllm-key;local-vllm-key
ENABLE_RAG_WEB_SEARCH=true
RAG_WEB_SEARCH_ENGINE=searxng

# SearXNG (profile: search). Generate with: openssl rand -hex 32
SEARXNG_SECRET=CHANGE_ME_SEARXNG_SECRET

# code-server (profile: ide)
CODESERVER_PASSWORD=CHANGE_ME_CODESERVER_PASSWORD
CODESERVER_SUDO_PASSWORD=
CODESERVER_WORKSPACE=/home/tforrester/projects
PUID=1000
PGID=1000
TZ=America/Chicago

# GitLab dev user created by scripts/gitlab-setup.sh
GITLAB_DEV_USER=theo
GITLAB_DEV_EMAIL=theo@local.dev
GITLAB_DEV_PASSWORD=CHANGE_ME_DEV_PASSWORD
