# =============================================================================
# Cloud Deployment Environment Configuration
# =============================================================================
# Copy this to .env.cloud on the instance and update passwords.
# Hostnames use *.devstack, resolved via Tailscale IP in Windows hosts file.

# Domain suffix for cloud services
DOMAIN_SUFFIX=devstack

# Hostnames (resolve via Tailscale IP in Windows hosts file)
HOMEPAGE_HOST=home.devstack
GITLAB_HOST=gitlab.devstack
NEXUS_HOST=nexus.devstack
PROMETHEUS_HOST=prometheus.devstack
GRAFANA_HOST=grafana.devstack
TRAEFIK_HOST=traefik.devstack
PORTAINER_HOST=portainer.devstack
REGISTRY_HOST=registry.devstack
MINIO_HOST=minio.devstack
MINIO_API_HOST=s3.devstack
VAULT_HOST=vault.devstack

# GitLab
GITLAB_SSH_PORT=2222
GITLAB_ROOT_PASSWORD=CHANGE_ME_GITLAB_PASSWORD

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# MinIO
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD

# TLS Certificate paths (generated by cloud-init via openssl)
TLS_CERT_FILE=/etc/traefik/certs/cert.pem
TLS_KEY_FILE=/etc/traefik/certs/key.pem
