# =============================================================================
# Spark 2 (spark-06ad) - Coder vLLM only, no dev stack
# =============================================================================
# Copy this to .env.spark-06ad and update model id as needed.

# vLLM - Qwen3-Coder-Next-FP8
VLLM_API_KEY=local-vllm-key
VLLM_CODER_MODEL=Qwen/Qwen3-Coder-Next-FP8
VLLM_CODER_PORT=8001
VLLM_CODER_HREF_HOST=spark-06ad
HF_CACHE_DIR=/home/tforrester/.cache/huggingface

# Unused on this host (Nemotron runs on spark-d5dd) — declared empty so compose
# doesn't warn when parsing the vllm-nemotron service's labels.
VLLM_NEMOTRON_MODEL=
VLLM_NEMOTRON_PORT=
VLLM_NEMOTRON_HREF_HOST=

# Bind-mount base — not used (no dev-stack services run here), but compose
# variable substitution still needs the var defined. Set to a harmless path.
VOLUMES_BASE=/home/tforrester/devstack/volumes

# Dev-stack hostnames — unused on this host but compose substitutes them at parse time.
DOMAIN_SUFFIX=spark-06ad
HOMEPAGE_HOST=home.spark-06ad
GITLAB_HOST=gitlab.spark-06ad
NEXUS_HOST=nexus.spark-06ad
PROMETHEUS_HOST=prometheus.spark-06ad
GRAFANA_HOST=grafana.spark-06ad
TRAEFIK_HOST=traefik.spark-06ad
PORTAINER_HOST=portainer.spark-06ad
REGISTRY_HOST=registry.spark-06ad
MINIO_HOST=minio.spark-06ad
MINIO_API_HOST=s3.spark-06ad
VAULT_HOST=vault.spark-06ad
GITLAB_SSH_PORT=2222
GITLAB_ROOT_PASSWORD=unused
GRAFANA_ADMIN_USER=unused
GRAFANA_ADMIN_PASSWORD=unused
MINIO_ROOT_USER=unused
MINIO_ROOT_PASSWORD=unused
TLS_CERT_FILE=/etc/traefik/certs/cert.pem
TLS_KEY_FILE=/etc/traefik/certs/key.pem
